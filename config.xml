<?xml version='1.0' encoding='utf-8'?>
<widget id="org.zoeisrad.sillyguy" version="26.10.23" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Silly</name>
    <description>
        i'm just a silly guy
    </description>

    <author href="https://everm4iva.github.io">
        ZoeisRad
    </author>

    <platform name="android">
        <icon density="ldpi" src="www/icons/icon.png" />
        <icon density="mdpi" src="www/icons/icon.png" />
        <icon density="hdpi" src="www/icons/icon.png" />
        <icon density="xhdpi" src="www/icons/icon.png" />
        <icon density="xxhdpi" src="www/icons/icon.png" />
        <icon density="xxxhdpi" src="www/icons/icon.png" />

